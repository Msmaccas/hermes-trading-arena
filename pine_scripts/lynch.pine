//@version=5
indicator(title="Lynch GARP Pack", shorttitle="GARP", overlay=true, format=format.price, precision=2)

// ═══════════════════════════════════════════════════════════════════════════
//  Peter Lynch GARP Indicator Pack
//  - RSI(14)
//  - SMA50, SMA200
//  - P/E ratio & PEG approximation via table
//  - Earnings growth rate display
//  - Volume vs 50d avg
//  - Category classification labels
//  - Lynch Checklist table
// ═══════════════════════════════════════════════════════════════════════════

// ─── Inputs ────────────────────────────────────────────────────────────────
showMA   = input.bool(true, "Show Moving Averages")
peRatio  = input.float(25.0, "P/E Ratio (manual)", step=0.5, minval=1)
epsGrowth = input.float(15.0, "EPS Growth % (manual)", step=1.0)

// ─── Moving Averages ───────────────────────────────────────────────────────
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
plot(sma50,  "SMA(50)",  color.orange, showMA ? 2 : 0)
plot(sma200, "SMA(200)", color.red,    showMA ? 1 : 0)

// ─── RSI(14) ───────────────────────────────────────────────────────────────
rsiVal = ta.rsi(close, 14)

// ─── Volume ────────────────────────────────────────────────────────────────
vol50Avg = ta.sma(volume, 50)
volRatio = volume / vol50Avg * 100

// ─── PEG Ratio ─────────────────────────────────────────────────────────────
pegRatio = peRatio / (epsGrowth > 0 ? epsGrowth : 1)

// ─── Category Classification ───────────────────────────────────────────────
// Based on EPS growth rate
category = "—"
if epsGrowth > 25
    category := "Fast Grower 🚀"
else if epsGrowth > 15
    category := "Stalwart"
else if epsGrowth > 5
    category := "Slow Grower"
else if epsGrowth < 0
    category := "Cyclical/Turnaround"
else
    category := "Asset Play"

// ─── Profit Margin Proxy ───────────────────────────────────────────────────
// Use price range as a crude margin proxy (higher priced = usually higher margin)
priceLevel = close > 100 ? "High" : close > 20 ? "Mid" : "Low"

// ─── Lynch Checklist Table ────────────────────────────────────────────────
var table t = table.new(position.bottom_right, 2, 12,
                        bgcolor=color.new(color.white, 90),
                        border_width=1, border_color=color.gray)

if barstate.islast
    pegOk        = pegRatio <= 1.5
    priceOk      = priceLevel != "Low"
    insiderOk    = true  // Placeholder — would need SEC filing data
    buybackOk    = true  // Placeholder — would need shares outstanding trend
    peterCheck = 0
    if pegOk:   peterCheck += 1
    if priceOk: peterCheck += 1

    table.cell(t, 0, 0,  "Lynch GARP",              text_color=color.white, bgcolor=color.navy,     text_size=size.small)
    table.cell(t, 1, 0,  category,                   text_color=color.white, bgcolor=color.navy,     text_size=size.small)

    table.cell(t, 0, 1,  "Category",                                                                 text_size=size.small)
    table.cell(t, 1, 1,  category,                                                                   text_size=size.small)
    table.cell(t, 0, 2,  "P/E",                                                                      text_size=size.small)
    table.cell(t, 1, 2,  str.tostring(peRatio, "#.#"),                                              text_size=size.small)
    table.cell(t, 0, 3,  "EPS Growth",                                                               text_size=size.small)
    table.cell(t, 1, 3,  str.tostring(epsGrowth, "#.#") + "%",                                      text_size=size.small)
    table.cell(t, 0, 4,  "PEG Ratio",                                                               text_size=size.small)
    table.cell(t, 1, 4,  str.tostring(pegRatio, "#.##") + (pegOk ? " ✓" : " ✗"),                   text_size=size.small)
    table.cell(t, 0, 5,  "RSI(14)",                                                                 text_size=size.small)
    table.cell(t, 1, 5,  str.tostring(rsiVal, "#.#"),                                               text_size=size.small)
    table.cell(t, 0, 6,  "Vol%",                                                                    text_size=size.small)
    table.cell(t, 1, 6,  str.tostring(int(volRatio)) + "%",                                         text_size=size.small)
    table.cell(t, 0, 7,  "Price Tier",                                                              text_size=size.small)
    table.cell(t, 1, 7,  priceLevel,                                                                text_size=size.small)
    table.cell(t, 0, 8,  "Price vs SMA50",                                                          text_size=size.small)
    table.cell(t, 1, 8,  str.tostring((close/sma50-1)*100, "#.##") + "%",                           text_size=size.small)
    table.cell(t, 0, 9,  "Price vs SMA200",                                                         text_size=size.small)
    table.cell(t, 1, 9,  str.tostring((close/sma200-1)*100, "#.##") + "%",                          text_size=size.small)
    table.cell(t, 0, 10, "PEG ≤ 1.5",                                                              text_size=size.small)
    table.cell(t, 1, 10, pegOk ? "YES ✓" : "NO ✗",                                                 text_size=size.small)
    table.cell(t, 0, 11, "Lynch Score",                                                             text_size=size.small)
    table.cell(t, 1, 11, str.tostring(peterCheck) + "/2",                                           text_size=size.small)

    barcolor(volRatio > 150 ? color.new(color.lime, 78) : na)
