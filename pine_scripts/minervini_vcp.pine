//@version=5
indicator(title="Minervini VCP Contraction", shorttitle="VCP", overlay=true, format=format.price, precision=2)

// ═══════════════════════════════════════════════════════════════════════════
//  Minervini VCP (Volatility Contraction Pattern) Detector
//  - Counts contraction waves (each wave has less volatility than last)
//  - ATR(14) contraction ratio tracking
//  - Volume contraction (right side drops to 10-20% of avg)
//  - RS line new high check
//  - Progressive exposure signal
//  - Tightness score
// ═══════════════════════════════════════════════════════════════════════════

// ─── Inputs ────────────────────────────────────────────────────────────────
showLabels        = input.bool(true, "Show Labels")
atrLen            = input.int(14, "ATR Length", minval=5, maxval=50)
waveLookback      = input.int(100, "Wave Lookback", minval=30)
minBaseLen        = input.int(25, "Min Base Length (bars)", minval=10)  // ~5 weeks
volContractionPct = input.float(0.30, "Max Vol on Right Side (% of avg)", step=0.05)
tightnessThresh   = input.float(0.15, "Tightness Threshold (ATR% of price)", step=0.01)

// ─── ATR ────────────────────────────────────────────────────────────────────
atrVal  = ta.atr(atrLen)
atrPct  = (atrVal / close) * 100
plot(atrPct, "ATR %", color.new(color.orange, 70), 1, display=display.none)
hline(1.5, "ATR High", color.new(color.red, 70), hline.style_dashed, display=display.none)

// ─── Base Detection ────────────────────────────────────────────────────────
highestHigh = ta.highest(high, waveLookback)
lowestLow   = ta.lowest(low, waveLookback)
baseDepthPct = (highestHigh - lowestLow) / highestHigh * 100

// ─── Volatility Wave Contraction ──────────────────────────────────────────
// Track ATR peaks to identify contraction waves
var float wave1Atr = na
var float wave2Atr = na
var float wave3Atr = na
var float wave4Atr = na
var int   waveCount = 0
var float baseHigh = na
var float baseLow = na
var int   baseStart = na
var bool  vcpDetected = false

// Detect local ATR peaks (swing points in volatility)
atrSma = ta.sma(atrPct, 5)
isAtrPeak = atrSma < atrSma[1] and atrSma[1] >= atrSma[2]

if isAtrPeak and waveLookback > 0
    waveCount := waveCount + 1
    if waveCount == 1
        wave1Atr := atrSma[1]
    else if waveCount == 2
        wave2Atr := atrSma[1]
    else if waveCount == 3
        wave3Atr := atrSma[1]
    else if waveCount >= 4
        wave4Atr := atrSma[1]

// VCP check: each wave has LOWER ATR
if not na(wave1Atr) and not na(wave2Atr)
    vcpDetected := wave2Atr < wave1Atr
    if not na(wave3Atr)
        vcpDetected := vcpDetected and wave3Atr < wave2Atr
    if not na(wave4Atr)
        vcpDetected := vcpDetected and wave4Atr < wave3Atr

// ─── Volume Contraction (right side) ──────────────────────────────────────
volAvg50 = ta.sma(volume, 50)
volRatio = volume / volAvg50
volContracted = volRatio < volContractionPct * 3  // < 30% of 50d avg = very low vol

// ─── Tightness Score (0-100) ──────────────────────────────────────────────
// Measures how tight the current range is relative to price
rangePct = (high - low) / close * 100
tightScore = 100 - math.min(rangePct / tightnessThresh * 100, 100)
plot(tightScore, "Tightness", color.new(color.green, 60), 2, display=display.none)
hline(70, "Tight", color.new(color.green, 60), hline.style_dashed, display=display.none)

// ─── RS Line (vs SPY) ──────────────────────────────────────────────────────
spyClose = request.security("SPY", timeframe.period, close)
var float rsLine = na
rsRatio = close / spyClose
if bar_index == 0
    rsLine := 100
else
    rsLine := rsLine[1] * (rsRatio / rsRatio[1])
rs50 = ta.sma(rsLine, 50)
rsNewHigh = rsLine >= ta.highest(rsLine, 100)
plot(rsLine, "RS Line", color.new(color.purple, 50), 1, display=display.none)
plot(rs50, "RS SMA(50)", color.new(color.purple, 30), 1, display=display.none)

// ─── VCP Composite Signal ────────────────────────────────────────────────
vcpSignal = vcpDetected and volContracted and tightScore > 70

// ─── Labels ──────────────────────────────────────────────────────────────
if showLabels
    if vcpDetected
        label.new(bar_index, high, "VCP W" + str.tostring(waveCount) +
                  "\nT:" + str.tostring(tightScore, "#") +
                  "\nATR:" + str.tostring(atrPct, "#.#") + "%",
                  style=label.style_label_down, color=color.new(color.blue, 60),
                  textcolor=color.white, size=size.small)
    if vcpSignal
        label.new(bar_index, low, "VCP SETUP",
                  style=label.style_label_up, color=color.new(color.green, 70),
                  textcolor=color.white, size=size.small)
        if rsNewHigh
            label.new(bar_index, low, "RS NH",
                      style=label.style_label_up, color=color.new(color.purple, 70),
                      textcolor=color.white, size=size.tiny, yloc=yloc.belowbar)

// ─── Bar Coloring ──────────────────────────────────────────────────────────
barcolor(vcpSignal ? color.green : vcpDetected ? color.blue : na)

// ─── Table: VCP Stats ──────────────────────────────────────────────────────
if barstate.islast
    var tbl = table.new(position.top_right, 4, 2, bgcolor=color.new(color.black, 80), border_width=1)
    table.cell(tbl, 0, 0, "VCP Waves", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, str.tostring(waveCount), text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 2, 0, "Tightness", text_color=color.white, text_size=size.small)
    table.cell(tbl, 3, 0, str.tostring(tightScore, "#") + "%", text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 1, "RS New High", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, rsNewHigh ? "YES" : "NO", text_color=rsNewHigh ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 2, 1, "Setup Ready", text_color=color.white, text_size=size.small)
    table.cell(tbl, 3, 1, vcpSignal ? "YES" : "NO", text_color=vcpSignal ? color.lime : color.red, text_size=size.small)

// ─── Alerts ────────────────────────────────────────────────────────────────
alertcondition(vcpSignal, title="VCP Setup Ready",
               message="VCP contraction pattern detected! {{ticker}} waves={{waveCount}} tight={{tightScore}}%")
